<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ghosthack</groupId>
    <artifactId>turbojpeg-ffm-parent</artifactId>
    <version>3.2.0-0.2.1</version>
  </parent>

  <artifactId>turbojpeg-ffm</artifactId>
  <packaging>jar</packaging>

  <name>turbojpeg-ffm</name>
  <description>jextract-generated FFM bindings for the TurboJPEG 3 API (libjpeg-turbo 3.2.0) with a runtime native-library loader</description>

  <dependencies>
    <dependency>
      <groupId>io.github.ghosthack</groupId>
      <artifactId>turbojpeg-ffm-natives</artifactId>
      <version>${project.version}</version>
      <classifier>${native.classifier}</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Filter version.properties so Version.VERSION always matches the pom. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>--add-modules</arg>
                <arg>java.desktop</arg>
                <arg>--add-reads</arg>
                <arg>turbojpeg.ffm=java.desktop</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>--enable-native-access=turbojpeg.ffm --add-modules=java.desktop --add-reads=turbojpeg.ffm=java.desktop</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
